<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window animation styles for the floating surfaces. `windowAnimations`
        takes a *style* that names the enter and exit animations. Every style
        is a plain fade; sheets fade in composition instead (SheetAnimation.kt).
    -->
    <style name="Animation.Jump.Popup" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/jump_popup_in</item>
        <item name="android:windowExitAnimation">@anim/jump_popup_out</item>
    </style>

    <style name="Animation.Jump.Scrim" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/jump_scrim_in</item>
        <item name="android:windowExitAnimation">@anim/jump_scrim_out</item>
    </style>
</resources>
