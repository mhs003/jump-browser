<?xml version="1.0" encoding="utf-8"?>
<!--
    Popup window entrance: a plain fade. No slide or scale — those read as
    slow and bouncy, and window animations are scaled down on many devices
    anyway. The surface keeps its final position and size throughout.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="120"
    android:fromAlpha="0.0"
    android:toAlpha="1.0" />
