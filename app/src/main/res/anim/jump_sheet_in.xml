<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom-sheet window: slides up from below the screen edge while the
    dim rises with it. Shared by the menu sheet and the tab list so both
    behave like the reference's measured container translation.
-->
<translate xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="180"
    android:fromYDelta="100%p"
    android:toYDelta="0"
    android:interpolator="@android:anim/decelerate_interpolator" />
